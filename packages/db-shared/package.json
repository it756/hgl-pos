{
  "name": "@hgl/db-shared",
  "private": true,
  "version": "0.0.0",
  "description": "Shared Drizzle schemas + SQL type definitions across apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-migrations": "tsx scripts/check-migration-compat.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.34.1"
  },
  "devDependencies": {
    "@hgl/config": "workspace:*",
    "@types/node": "^20.16.11",
    "drizzle-kit": "^0.26.2",
    "eslint": "^9.13.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
