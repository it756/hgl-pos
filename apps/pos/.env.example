# Local dev — copy to .env.local and fill in from `supabase status`.
# Used for: ReliableClock's network-time source (auth/v1/health), and the
# T106-T108 cross-till refund flow (the one connectivity-required action —
# see lib/events/refund.ts).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-from-supabase-status
