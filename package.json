{
  "name": "@hgl/monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Harvest Group Retail POS — 16-store rollout (spec 001-retail-pos-mvp)",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "pnpm -r --parallel run lint",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "pnpm -r --parallel run test",
    "test:pgtap": "supabase test db",
    "test:sync-rules": "pnpm --filter powersync-tests test",
    "dev:admin": "pnpm --filter @hgl/admin dev",
    "dev:pos": "pnpm --filter @hgl/pos dev",
    "tauri:dev": "pnpm --filter @hgl/pos tauri:dev",
    "tauri:build": "pnpm --filter @hgl/pos tauri:build",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:seed": "psql \"$SUPABASE_DB_URL\" -f supabase/seed/seed.sql",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
